import sys
sys.stdout.reconfigure(encoding='utf-8')

from datetime import datetime
from bs4 import BeautifulSoup

from selenium import webdriver
from selenium.webdriver.common.by import By
from selenium.webdriver.support.ui import WebDriverWait
from selenium.webdriver.support import expected_conditions as EC


def get_lift_status():
    driver = webdriver.Chrome()
    driver.get('https://www.niseko.ne.jp/en/niseko-lift-status/')

    # Wait until at least one lift name <p> is visible inside liftStatusArea
    WebDriverWait(driver, 15).until(
        EC.presence_of_element_located((By.CSS_SELECTOR, "#liftStatusArea ul[id] > li p"))
    )

    soup = BeautifulSoup(driver.page_source, 'html.parser')
    driver.quit()

    lift_status_area = soup.find("div", id="liftStatusArea")

    result = {}

    # Each resort is wrapped in a <li id="liftList_tag_*">
    resort_lis = lift_status_area.find_all("li", id=lambda x: x and x.startswith("liftList_tag_"))

    for resort_li in resort_lis:
        # Resort name is in <h3>
        h3 = resort_li.find("h3")
        resort_name = h3.get_text(strip=True) if h3 else "Unknown Resort"
        result[resort_name] = {}

        # Each lift group is a <ul id="..."> with class containing flex
        lift_uls = resort_li.find_all("ul", id=True)

        for ul in lift_uls:
            # Skip the header ul (class="liftListHeader")
            if "liftListHeader" in (ul.get("class") or []):
                continue

            lis = ul.find_all("li", recursive=False)

            # Structure per lift <ul> (confirmed from DOM):
            #   li[0] → <p>Lift Name</p>
            #   li[1] → operating hours (skip)
            #   li[2] → <p>Operating / Suspended / Closed</p>
            #   li[3] → <p><img class="liftStatusPic"></p>
            #   li[4] → extra info
            if len(lis) < 3:
                continue

            lift_name   = lis[0].get_text(strip=True) or None
            lift_status = lis[2].get_text(strip=True) or "-"

            # Sanity check: if li[2] contains an image the layout shifted
            if lis[2].find("img", class_="liftStatusPic"):
                lift_status = "-"

            if lift_name:
                result[resort_name][lift_name] = lift_status

    return result


def get_data():
    resort_name  = {"resort_name": "Niseko United"}
    last_updated = {"last_updated": datetime.now().strftime('%Y-%m-%d %H:%M')}
    lift_dic     = get_lift_status()

    final_return = [
        resort_name,
        lift_dic,
        last_updated,
    ]

    return final_return


if __name__ == "__main__":
    data = get_data()
    for item in data:
        print(item)